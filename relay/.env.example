# Hostname/IP shown to Bedrock clients for relay bind ports (required in production)
PUBLIC_HOST=127.0.0.1

# Optional: reject requests without Authorization: Bearer <token>
RELAY_API_TOKEN=

# HTTP listen
PORT=8787

# Geyser launch mode: standalone | docker
GEYSER_MODE=standalone

# Path to Geyser standalone jar (standalone mode)
GEYSER_JAR_PATH=./geyser.jar

# Working dir for generated config.yml files
GEYSER_SESSIONS_DIR=./.geyser-sessions

# Port range for Bedrock bind (inclusive)
PORT_POOL_MIN=19132
PORT_POOL_MAX=19232

# Rate limit (requests per window per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Allow relaying to RFC1918 / loopback targets (default: block)
ALLOW_PRIVATE_TARGETS=false