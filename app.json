{
  "expo": {
    "name": "NetherNet",
    "slug": "nethernet",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "nethernet",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cuboagency.nethernet",
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          }
        ]
      },
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "minecraft"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "NetherNet connects to a relay on your local network so a Java server can be opened in Bedrock.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "gg.nethernet.app",
      "adaptiveIcon": {
        "backgroundColor": "#0C0911",
        "foregroundImage": "./assets/images/icon.png"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C0911",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": false
    },
    "extra": {
      "relayUrl": "",
      "privacyPolicyUrl": "https://commander17x.github.io/NetherNet/privacy/",
      "supportUrl": "https://commander17x.github.io/NetherNet/support/",
      "eas": {
        "projectId": "d55e9dd8-2eb7-48a8-8bb5-0aadf553f68c"
      }
    },
    "owner": "jaimyk"
  }
}
